// We introduce this namespace so that native bridge guest libraries are built
// only for targets that explicitly use this namespace via PRODUCT_SOONG_NAMESPACES
// and checkbuild.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libm_for_native_bridge",
    defaults: [
        // Definitions come from bionic/libm/Android.bp
        "libm_defaults",
    ],
}

cc_library {
    name: "libnative_bridge_guest_libm",
    defaults: [
        "native_bridge_stub_library_defaults",
    ],

    whole_static_libs: ["libm_for_native_bridge"],

    arch: {
        arm: {
            srcs: ["stubs_arm.cpp"],
        },
        arm64: {
            srcs: ["stubs_arm64.cpp"],
        },
        riscv64: {
            srcs: ["stubs_riscv64.cpp"],
        },
    },

    overrides: ["libm"],
    stem: "libm",
}

filegroup {
    name: "native_bridge_proxy_libm_files",
    srcs: [
        "proxy/libm_trampolines.cc",
    ],
}

cc_defaults {
    name: "native_bridge_proxy_libm_defaults",
    srcs: [":native_bridge_proxy_libm_files"],
    header_libs: [
        "libberberis_guest_abi_headers",
        "libberberis_proxy_loader_headers",
    ],
}
